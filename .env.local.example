# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — defaults to gemini-3.6-flash (gemini-2.x series was retired by Google).
# On 503/high-demand or retired-model errors the app auto-cascades:
# <GEMINI_MODEL or 3.6-flash> → gemini-3.7-flash → gemini-3.8-flash → gemini-3-flash-preview
# GEMINI_MODEL=gemini-3.6-flash

# Client-visible limits (must be prefixed NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=20
NEXT_PUBLIC_MAX_PAGES=50
