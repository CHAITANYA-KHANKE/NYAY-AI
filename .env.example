# ==============================================================================
# NyayAI Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your own API credentials.
# Note: NEVER commit .env.local to version control.
# ==============================================================================

# Google Gemini API Key (Required for AI analysis and Q&A chat)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model selection (defaults to gemini-3.6-flash)
# Automatic fallback cascade handles 503 / high-demand / retired model states:
# gemini-3.6-flash -> gemini-3.7-flash -> gemini-3.8-flash -> gemini-3-flash-preview
GEMINI_MODEL=gemini-3.6-flash

# Client-visible limits (Exposed to frontend via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=20
NEXT_PUBLIC_MAX_PAGES=50
